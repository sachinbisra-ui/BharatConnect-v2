{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered citizen profile containing verification credentials and trust metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth user ID" },
        "name": { "type": "string", "description": "Citizen full name" },
        "phone": { "type": "string", "description": "Phone number with country code" },
        "email": { "type": "string", "description": "BharatConnect email address" },
        "maskedId": { "type": "string", "description": "Masked demo identity document number" },
        "trustScore": { "type": "number", "description": "Computed digital trust score out of 900" },
        "avatarBg": { "type": "string", "description": "Avatar tailwind color class" },
        "avatarText": { "type": "string", "description": "Avatar initials text" },
        "status": { "type": "string", "enum": ["verified", "pending", "unverified", "suspicious"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "phone"]
    },
    "MessageThread": {
      "title": "MessageThread",
      "description": "Conversation thread between citizens or institutions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "participantPhones": { "type": "array", "items": { "type": "string" } },
        "senderName": { "type": "string" },
        "senderPhoneOrOrg": { "type": "string" },
        "senderType": { "type": "string" },
        "status": { "type": "string" },
        "avatarText": { "type": "string" },
        "avatarBg": { "type": "string" },
        "lastMessage": { "type": "string" },
        "timestamp": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "verifiedReason": { "type": "string" },
        "signals": { "type": "array", "items": { "type": "string" } },
        "isSuspiciousAlert": { "type": "boolean" },
        "suspiciousWarning": { "type": "string" }
      },
      "required": ["lastMessage"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual verified chat message inside a thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhone": { "type": "string" },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "demoTrustVerified": { "type": "boolean" }
      },
      "required": ["senderUid", "text", "threadId"]
    },
    "BharatEmail": {
      "title": "BharatEmail",
      "description": "DKIM and Trust-token verified email message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUid": { "type": "string" },
        "fromName": { "type": "string" },
        "fromEmail": { "type": "string" },
        "toEmail": { "type": "string" },
        "toUid": { "type": "string" },
        "subject": { "type": "string" },
        "preview": { "type": "string" },
        "body": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "isSuspicious": { "type": "boolean" },
        "suspiciousReason": { "type": "string" },
        "trustCertificateDemo": { "type": "string" },
        "securityChecks": {
          "type": "object",
          "properties": {
            "dkim": { "type": "boolean" },
            "spf": { "type": "boolean" },
            "bharatTrustToken": { "type": "boolean" },
            "domainMatch": { "type": "boolean" }
          }
        },
        "readBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["fromEmail", "toEmail", "subject", "body"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Citizen profile data"
    },
    "/threads/{threadId}": {
      "schema": "MessageThread",
      "description": "Conversation threads"
    },
    "/threads/{threadId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside a thread"
    },
    "/emails/{emailId}": {
      "schema": "BharatEmail",
      "description": "BharatMail inbox and sent messages"
    }
  }
}
